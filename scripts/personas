#!/usr/bin/env node
// Manage advisory personas: list, enable, disable.
// Personas are personas/*.md files with simple YAML frontmatter.
'use strict';
const fs = require('fs');
const path = require('path');

const ROOT = path.resolve(__dirname, '..');
const DIR = path.join(ROOT, 'personas');

function parseFrontmatter(text) {
  const m = text.match(/^---\n([\s\S]*?)\n---\n/);
  if (!m) return null;
  const out = {};
  for (const line of m[1].split('\n')) {
    const kv = line.match(/^([a-z_]+):\s*(.*)$/);
    if (!kv) continue;
    let v = kv[2].trim();
    if (v.startsWith('[') && v.endsWith(']')) {
      v = v.slice(1, -1).split(',').map((s) => s.trim()).filter(Boolean);
    } else if (v === 'true' || v === 'false') {
      v = v === 'true';
    } else {
      v = v.replace(/^"(.*)"$/, '$1');
    }
    out[kv[1]] = v;
  }
  return out;
}

function load() {
  return fs
    .readdirSync(DIR)
    .filter((f) => f.endsWith('.md') && f !== 'README.md')
    .map((f) => {
      const text = fs.readFileSync(path.join(DIR, f), 'utf8');
      const fm = parseFrontmatter(text);
      if (!fm) throw new Error(`${f}: missing frontmatter`);
      return { file: f, text, ...fm };
    })
    .sort((a, b) => a.id.localeCompare(b.id));
}

function setEnabled(id, value) {
  const p = load().find((x) => x.id === id);
  if (!p) {
    console.error(`no persona with id "${id}"`);
    process.exit(1);
  }
  const updated = p.text.replace(/^enabled:.*$/m, `enabled: ${value}`);
  fs.writeFileSync(path.join(DIR, p.file), updated);
  console.log(`${id}: enabled: ${value}`);
}

const [cmd, arg] = process.argv.slice(2);
switch (cmd) {
  case 'list':
  case undefined: {
    for (const p of load()) {
      const flag = p.enabled ? 'on ' : 'off';
      const gates = Array.isArray(p.gates) ? p.gates.join(',') : '';
      console.log(`${flag}  ${p.id.padEnd(15)} ${p.name.padEnd(32)} gates: ${gates}`);
    }
    break;
  }
  case 'json':
    console.log(JSON.stringify(load().map(({ text, ...p }) => p), null, 2));
    break;
  case 'enable':
    setEnabled(arg, true);
    break;
  case 'disable':
    setEnabled(arg, false);
    break;
  default:
    console.error('usage: scripts/personas [list|json|enable <id>|disable <id>]');
    process.exit(2);
}
