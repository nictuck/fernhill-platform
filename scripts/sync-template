#!/usr/bin/env bash
# Copy the parts of the platform that every product repo must share into
# the template checkout, so hooks and review policy never drift.
#   scripts/sync-template [path-to-template-checkout]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE="${1:-$ROOT/../fernhill-product-template}"
[ -d "$TEMPLATE" ] || { echo "template checkout not found: $TEMPLATE" >&2; exit 1; }

# The template's main is protected; sync only onto a clean feature branch so
# the result lands in a PR and never as stray changes on main.
tb=$(git -C "$TEMPLATE" branch --show-current)
if [ "$tb" = "main" ] || [ -z "$tb" ]; then
  echo "template checkout is on '${tb:-detached}'; switch it to a feature branch first (git -C \"$TEMPLATE\" switch -c template/<change>)" >&2; exit 1
fi
if [ -n "$(git -C "$TEMPLATE" status --porcelain)" ]; then
  echo "template checkout has uncommitted changes; commit or stash them first" >&2; exit 1
fi

mkdir -p "$TEMPLATE/.claude/hooks" "$TEMPLATE/.github/workflows"
cp "$ROOT"/.claude/hooks/*.sh "$TEMPLATE/.claude/hooks/"
cp "$ROOT/REVIEW.md" "$TEMPLATE/REVIEW.md"
mkdir -p "$TEMPLATE/.claude/skills/review"
cp "$ROOT/.claude/skills/review/SKILL.md" "$TEMPLATE/.claude/skills/review/SKILL.md"
cp "$ROOT/.github/workflows/release.yml" "$TEMPLATE/.github/workflows/release.yml"

# Product repos get the same hooks; permissions add the product commands.
jq '.permissions.allow = (.permissions.allow + ["Bash(make build)","Bash(make test)","Bash(make lint)","Bash(make dev)","Bash(npm test*)","Bash(npm run *)","Bash(npx vitest*)"] | unique)
    | .permissions.allow -= ["Bash(scripts/personas *)","Bash(scripts/validate-artifacts *)"]' \
  "$ROOT/.claude/settings.json" > "$TEMPLATE/.claude/settings.json"

echo "synced hooks, REVIEW.md, release.yml and settings.json → $TEMPLATE"
